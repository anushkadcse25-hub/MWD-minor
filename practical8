<!DOCTYPE html>
<html>
<head>
    <title>Student Registration</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100">

    <div class="max-w-md mx-auto mt-10 bg-white p-6 rounded shadow">

        <h2 class="text-2xl font-bold mb-5 text-center">
            Student Registration
        </h2>

        <form id="registrationForm">

            <!-- Name -->
            <label>Student Name</label>
            <input type="text" id="name"
                class="w-full border p-2 mb-1 rounded">

            <p id="nameError" class="text-red-500 text-sm mb-3"></p>

            <!-- Email -->
            <label>Email</label>
            <input type="text" id="email"
                class="w-full border p-2 mb-1 rounded">

            <p id="emailError" class="text-red-500 text-sm mb-3"></p>

            <!-- Password -->
            <label>Password</label>
            <input type="password" id="password"
                class="w-full border p-2 mb-1 rounded">

            <!-- Show Password -->
            <button type="button" id="togglePassword"
                class="text-blue-600 text-sm mb-1">
                Show Password
            </button>

            <p id="passwordError" class="text-red-500 text-sm mb-3"></p>

            <!-- Mobile -->
            <label>Mobile Number</label>
            <input type="text" id="mobile"
                class="w-full border p-2 mb-1 rounded">

            <p id="mobileError" class="text-red-500 text-sm mb-3"></p>

            <!-- Register Button -->
            <button type="submit"
                class="w-full bg-blue-500 hover:bg-blue-600 text-white p-2 rounded">
                Register
            </button>

            <p id="message" class="mt-4 text-center"></p>

        </form>
    </div>

    <script>
        const form = document.getElementById("registrationForm");
        const password = document.getElementById("password");
        const togglePassword = document.getElementById("togglePassword");

        // Show / Hide Password
        togglePassword.onclick = function () {
            if (password.type === "password") {
                password.type = "text";
                togglePassword.innerHTML = "Hide Password";
            } else {
                password.type = "password";
                togglePassword.innerHTML = "Show Password";
            }
        };

        form.onsubmit = function (event) {
            event.preventDefault();

            let name = document.getElementById("name").value.trim();
            let email = document.getElementById("email").value.trim();
            let pass = password.value;
            let mobile = document.getElementById("mobile").value.trim();

            let message = document.getElementById("message");

            // Clear previous errors
            document.querySelectorAll("form p[id$='Error']").forEach(error => {
                error.innerHTML = "";
            });

            message.innerHTML = "";
            message.className = "mt-4 text-center";

            let valid = true;

            // Name validation
            if (name === "") {
                document.getElementById("nameError").innerHTML =
                    "Please enter your name.";
                document.getElementById("name").classList.add("border-red-500");
                valid = false;
            } else {
                document.getElementById("name").classList.remove("border-red-500");
            }

            // Email validation
            if (email === "") {
                document.getElementById("emailError").innerHTML =
                    "Please enter your email.";
                document.getElementById("email").classList.add("border-red-500");
                valid = false;
            } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                document.getElementById("emailError").innerHTML =
                    "Enter a valid email address.";
                document.getElementById("email").classList.add("border-red-500");
                valid = false;
            } else {
                document.getElementById("email").classList.remove("border-red-500");
            }

            // Password validation
            if (pass === "") {
                document.getElementById("passwordError").innerHTML =
                    "Please enter your password.";
                password.classList.add("border-red-500");
                valid = false;
            } else if (pass.length < 6) {
                document.getElementById("passwordError").innerHTML =
                    "Password must be at least 6 characters.";
                password.classList.add("border-red-500");
                valid = false;
            } else if (!/[@#$%^&*]/.test(pass)) {
                document.getElementById("passwordError").innerHTML =
                    "Password must contain at least one special character (@#$%^&*).";
                password.classList.add("border-red-500");
                valid = false;
            } else {
                password.classList.remove("border-red-500");
            }

            // Mobile validation
            if (mobile === "") {
                document.getElementById("mobileError").innerHTML =
                    "Please enter your mobile number.";
                document.getElementById("mobile").classList.add("border-red-500");
                valid = false;
            } else if (!/^[0-9]{10}$/.test(mobile)) {
                document.getElementById("mobileError").innerHTML =
                    "Enter a valid 10-digit mobile number.";
                document.getElementById("mobile").classList.add("border-red-500");
                valid = false;
            } else {
                document.getElementById("mobile").classList.remove("border-red-500");
            }

            // Stop if invalid
            if (!valid) {
                message.innerHTML = "Please correct the errors below.";
                message.classList.add("text-red-500");
                return;
            }

            // Success
            message.innerHTML = "Registration Successful!";
            message.classList.add("text-green-500");

            form.reset();
            password.type = "password";
            togglePassword.innerHTML = "Show Password";
        };
    </script>

</body>
</html>
