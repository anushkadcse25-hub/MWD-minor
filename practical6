<!DOCTYPE html>
<html>
<head>
    <title>PRACTICAL 06 - Student Grade Calculator</title>

    
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-gradient-to-br from-blue-200 via-purple-200 to-pink-200 flex items-center justify-center p-6">

    <div class="w-full max-w-2xl bg-white rounded-3xl shadow-2xl p-8">

     
        <div class="text-center mb-6">
            <h1 class="text-3xl font-bold text-blue-700">
                Student Grade Calculator
            </h1>

            <p class="text-gray-500 mt-2">
                PRACTICAL 06
            </p>
        </div>

        
        <div class="bg-blue-50 rounded-xl p-4 mb-6">
            <p class="text-gray-700">
                <b>Name:</b> Anushka Dakhole
            </p>

            <p class="text-gray-700 mt-1">
                <b>USN:</b> CS25013
            </p>
        </div>


        <table class="w-full border-collapse overflow-hidden rounded-xl">

            <thead>
                <tr class="bg-blue-600 text-white">
                    <th class="p-4 text-left">
                        Subject
                    </th>

                    <th class="p-4 text-center">
                        Enter Marks
                    </th>
                </tr>
            </thead>

            <tbody>

                <tr class="hover:bg-blue-50">
                    <td class="border p-3 font-semibold">
                        DMGT
                    </td>

                    <td class="border p-3">
                        <input type="number" id="sub1"
                            min="0" max="100"
                            placeholder="0 - 100"
                            class="w-full border-2 border-gray-200 rounded-lg p-2 text-center outline-none focus:border-blue-500">
                    </td>
                </tr>

                <tr class="hover:bg-blue-50">
                    <td class="border p-3 font-semibold">
                        CAO
                    </td>

                    <td class="border p-3">
                        <input type="number" id="sub2"
                            min="0" max="100"
                            placeholder="0 - 100"
                            class="w-full border-2 border-gray-200 rounded-lg p-2 text-center outline-none focus:border-blue-500">
                    </td>
                </tr>

                <tr class="hover:bg-blue-50">
                    <td class="border p-3 font-semibold">
                         MDM
                    </td>

                    <td class="border p-3">
                        <input type="number" id="sub3"
                            min="0" max="100"
                            placeholder="0 - 100"
                            class="w-full border-2 border-gray-200 rounded-lg p-2 text-center outline-none focus:border-blue-500">
                    </td>
                </tr>

                <tr class="hover:bg-blue-50">
                    <td class="border p-3 font-semibold">
                        FCC
                    </td>

                    <td class="border p-3">
                        <input type="number" id="sub4"
                            min="0" max="100"
                            placeholder="0 - 100"
                            class="w-full border-2 border-gray-200 rounded-lg p-2 text-center outline-none focus:border-blue-500">
                    </td>
                </tr>

                <tr class="hover:bg-blue-50">
                    <td class="border p-3 font-semibold">
                         ED
                    </td>

                    <td class="border p-3">
                        <input type="number" id="sub5"
                            min="0" max="100"
                            placeholder="0 - 100"
                            class="w-full border-2 border-gray-200 rounded-lg p-2 text-center outline-none focus:border-blue-500">
                    </td>
                </tr>

            </tbody>
        </table>

        
        <div class="text-center mt-6">

            <button onclick="calculateGrade()"
                class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-8 py-3 rounded-xl shadow-lg transition duration-300">

                Calculate Result

            </button>

        </div>

        
        <div class="mt-8">

            <h2 class="text-xl font-bold text-gray-700 mb-3">
                 Result
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

               
                <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
                    <p class="text-gray-500 font-semibold">
                        Total Marks
                    </p>

                    <p id="total"
                        class="text-2xl font-bold text-blue-600 mt-2">
                        -
                    </p>
                </div>

                
                <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 text-center">
                    <p class="text-gray-500 font-semibold">
                        Percentage
                    </p>

                    <p id="percentage"
                        class="text-2xl font-bold text-purple-600 mt-2">
                        -
                    </p>
                </div>
                <div class="bg-green-50 border border-green-200 rounded-xl p-4 text-center">
                    <p class="text-gray-500 font-semibold">
                        Grade
                    </p>

                    <p id="grade"
                        class="text-2xl font-bold text-green-600 mt-2">
                        -
                    </p>
                </div>

            </div>

        </div>

     
        <p class="text-center text-gray-400 text-sm mt-7">
            Student Grade Calculator | PRACTICAL 06
        </p>

    </div>


    <script>

        function calculateGrade() {

            let inputs = [
                document.getElementById("sub1"),
                document.getElementById("sub2"),
                document.getElementById("sub3"),
                document.getElementById("sub4"),
                document.getElementById("sub5")
            ];

            
            for (let input of inputs) {

                if (input.value === "") {
                    alert("Please enter marks for all subjects.");
                    return;
                }

                // Check marks range
                if (Number(input.value) < 0 || Number(input.value) > 100) {
                    alert("Marks should be between 0 and 100.");
                    return;
                }
            }

            let m1 = Number(inputs[0].value);
            let m2 = Number(inputs[1].value);
            let m3 = Number(inputs[2].value);
            let m4 = Number(inputs[3].value);
            let m5 = Number(inputs[4].value);

            alert(m3);
            let total = m1 + m2 + m3 + m4 + m5;

            
            let percentage = (total / 500) * 100;

           
            let grade;

            if (percentage >= 90) {
                grade = "A+";
            }
            else if (percentage >= 80) {
                grade = "A";
            }
            else if (percentage >= 70) {
                grade = "B";
            }
            else if (percentage >= 60) {
                grade = "C";
            }
            else if (percentage >= 50) {
                grade = "D";
            }
            else {
                grade = "F";
            }

            
            document.getElementById("total").innerHTML =
                total + " / 500";

            document.getElementById("percentage").innerHTML =
                percentage.toFixed(2) + "%";

            document.getElementById("grade").innerHTML =
                grade;
        }

    </script>

</body>
</html>
