
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SpiceRoute | Authentic Indian Street Food</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background-color: #fffaf0;
    }

    .hero-bg {
      background: linear-gradient(120deg, #351b35, #572d46);
    }

    .accent {
      color: #c75b39;
    }

    .gold {
      color: #e5b85c;
    }

    .food-card {
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .food-card:hover {
      transform: translateY(-7px);
      box-shadow: 0 18px 35px rgba(53, 27, 53, 0.13);
    }

    .btn-primary {
      background: #c75b39;
      color: white;
      transition: 0.3s;
    }

    .btn-primary:hover {
      background: #a9442d;
    }
  </style>
</head>

<body class="text-[#351b35]">

  <!-- NAVBAR -->
  <header class="sticky top-0 z-50 bg-[#fffaf0]/95 backdrop-blur-md shadow-sm">
    <nav class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
      <a href="#" class="text-2xl font-extrabold tracking-tight text-[#572d46]">
        <i class="fa-solid fa-pepper-hot text-[#c75b39] mr-2"></i>SpiceRoute
      </a>

      <div class="hidden md:flex items-center gap-8 font-medium text-sm">
        <a href="#home" class="hover:text-[#c75b39]">Home</a>
        <a href="#menu" class="hover:text-[#c75b39]">Our Menu</a>
        <a href="#about" class="hover:text-[#c75b39]">Our Story</a>
        <a href="#contact" class="hover:text-[#c75b39]">Contact</a>
      </div>

      <a href="#menu" class="hidden md:inline-block btn-primary px-6 py-3 rounded-full text-sm font-semibold">
        Explore Menu
      </a>

      <button id="menuBtn" class="md:hidden text-2xl text-[#572d46]" aria-label="Open menu">
        <i class="fa-solid fa-bars"></i>
      </button>
    </nav>

    <div id="mobileMenu" class="hidden md:hidden px-6 pb-5 space-y-3 bg-[#fffaf0]">
      <a href="#home" class="block py-2">Home</a>
      <a href="#menu" class="block py-2">Our Menu</a>
      <a href="#about" class="block py-2">Our Story</a>
      <a href="#contact" class="block py-2">Contact</a>
    </div>
  </header>

  <!-- HERO -->
  <section id="home" class="hero-bg text-white">
    <div class="max-w-7xl mx-auto px-6 py-20 md:py-28 grid md:grid-cols-2 gap-12 items-center">
      <div>
        <span class="inline-block border border-[#e5b85c] text-[#e5b85c] rounded-full px-4 py-2 text-xs font-semibold tracking-wider mb-6">
          <i class="fa-solid fa-fire mr-2"></i>AUTHENTIC INDIAN STREET FOOD
        </span>

        <h1 class="text-4xl md:text-6xl font-extrabold leading-tight mb-6">
          A Little Spice.<br>
          <span class="text-[#e5b85c]">A Lot of Love.</span>
        </h1>

        <p class="text-white/75 text-base md:text-lg leading-relaxed mb-8 max-w-lg">
          Discover the vibrant taste of India with freshly prepared street-food favourites, traditional recipes, and flavours that bring people together.
        </p>

        <div class="flex flex-wrap gap-4">
          <a href="#menu" class="btn-primary px-7 py-3.5 rounded-full font-semibold">
            Explore Our Menu <i class="fa-solid fa-arrow-right ml-2"></i>
          </a>
          <a href="#about" class="border border-white/40 px-7 py-3.5 rounded-full font-semibold hover:bg-white/10">
            Our Story
          </a>
        </div>

        <div class="flex gap-8 mt-12">
          <div>
            <p class="text-2xl font-bold text-[#e5b85c]">100%</p>
            <p class="text-xs text-white/70">Fresh Ingredients</p>
          </div>
          <div>
            <p class="text-2xl font-bold text-[#e5b85c]">20+</p>
            <p class="text-xs text-white/70">Indian Favourites</p>
          </div>
          <div>
            <p class="text-2xl font-bold text-[#e5b85c]">4.9★</p>
            <p class="text-xs text-white/70">Guest Rating</p>
          </div>
        </div>
      </div>

      <div class="relative">
        <img
          src="https://images.unsplash.com/photo-1601050690597-df0568f70950?auto=format&fit=crop&w=1000&q=85"
          alt="Indian samosas served with chutney"
          class="w-full h-[350px] md:h-[500px] object-cover rounded-[2rem] shadow-2xl"
        >
        <div class="absolute -bottom-5 -left-3 md:-left-8 bg-[#fffaf0] text-[#351b35] p-5 rounded-2xl shadow-xl">
          <p class="text-xs uppercase tracking-wider text-[#c75b39] font-bold">Made with love</p>
          <p class="font-bold text-lg">Flavours of India</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="py-10 bg-[#f5e8d5]">
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 sm:grid-cols-3 gap-8 text-center">
      <div>
        <i class="fa-solid fa-leaf text-2xl text-[#c75b39] mb-3"></i>
        <h3 class="font-bold">Fresh Ingredients</h3>
        <p class="text-sm text-[#755b66] mt-1">Prepared fresh every day</p>
      </div>
      <div>
        <i class="fa-solid fa-utensils text-2xl text-[#c75b39] mb-3"></i>
        <h3 class="font-bold">Traditional Recipes</h3>
        <p class="text-sm text-[#755b66] mt-1">Inspired by India's food culture</p>
      </div>
      <div>
        <i class="fa-solid fa-heart text-2xl text-[#c75b39] mb-3"></i>
        <h3 class="font-bold">Made with Love</h3>
        <p class="text-sm text-[#755b66] mt-1">Every bite feels like home</p>
      </div>
    </div>
  </section>

  <!-- MENU -->
  <section id="menu" class="py-20 md:py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-12">
        <p class="accent font-bold text-sm tracking-widest uppercase mb-3">Our Specialities</p>
        <h2 class="text-3xl md:text-5xl font-extrabold text-[#351b35]">A Taste of the Streets</h2>
        <p class="text-[#755b66] mt-4 max-w-2xl mx-auto">
          From crispy snacks to comforting classics, find your next favourite on our menu.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">

        <!-- DISH 1 -->
        <div class="food-card bg-white rounded-3xl overflow-hidden border border-[#f0dfcf]">
          <img src="https://images.unsplash.com/photo-1601050690117-94f5f6fa8bd7?auto=format&fit=crop&w=900&q=85"
               alt="Crispy samosas" class="w-full h-56 object-cover">
          <div class="p-6">
            <div class="flex justify-between items-start gap-3">
              <h3 class="font-bold text-xl">Punjabi Samosa</h3>
              <span class="font-bold text-[#c75b39]">₹99</span>
            </div>
            <p class="text-sm text-[#755b66] mt-3 leading-relaxed">
              Golden, crispy pastry filled with spiced potatoes and peas, served with chutney.
            </p>
            <div class="flex justify-between items-center mt-5">
              <span class="text-sm text-[#9a7c80]"><i class="fa-solid fa-star text-[#e5b85c] mr-1"></i>4.9 (150+)</span>
              <span class="text-xs bg-[#f5e8d5] text-[#572d46] px-3 py-1 rounded-full">Bestseller</span>
            </div>
          </div>
        </div>

        <!-- DISH 2 -->
        <div class="food-card bg-white rounded-3xl overflow-hidden border border-[#f0dfcf]">
          <img src="https://images.unsplash.com/photo-1606491956689-2ea866880c84?auto=format&fit=crop&w=900&q=85"
               alt="Pav bhaji" class="w-full h-56 object-cover">
          <div class="p-6">
            <div class="flex justify-between items-start gap-3">
              <h3 class="font-bold text-xl">Mumbai Pav Bhaji</h3>
              <span class="font-bold text-[#c75b39]">₹179</span>
            </div>
            <p class="text-sm text-[#755b66] mt-3 leading-relaxed">
              Rich, buttery mashed vegetables served with toasted pav, onions, and lemon.
            </p>
            <div class="flex justify-between items-center mt-5">
              <span class="text-sm text-[#9a7c80]"><i class="fa-solid fa-star text-[#e5b85c] mr-1"></i>4.8 (110+)</span>
              <span class="text-xs bg-[#f5e8d5] text-[#572d46] px-3 py-1 rounded-full">Popular</span>
            </div>
          </div>
        </div>

        <!-- DISH 3 -->
        <div class="food-card bg-white rounded-3xl overflow-hidden border border-[#f0dfcf]">
          <img src="https://images.unsplash.com/photo-1601050690597-df0568f70950?auto=format&fit=crop&w=900&q=85"
               alt="Indian chaat" class="w-full h-56 object-cover">
          <div class="p-6">
            <div class="flex justify-between items-start gap-3">
              <h3 class="font-bold text-xl">Dilli Aloo Chaat</h3>
              <span class="font-bold text-[#c75b39]">₹149</span>
            </div>
            <p class="text-sm text-[#755b66] mt-3 leading-relaxed">
              Crispy potatoes tossed with tangy chutneys, spices, and fresh coriander.
            </p>
            <div class="flex justify-between items-center mt-5">
              <span class="text-sm text-[#9a7c80]"><i class="fa-solid fa-star text-[#e5b85c] mr-1"></i>4.7 (95+)</span>
              <span class="text-xs bg-[#f5e8d5] text-[#572d46] px-3 py-1 rounded-full">Tangy</span>
            </div>
          </div>
        </div>

        <!-- DISH 4 -->
        <div class="food-card bg-white rounded-3xl overflow-hidden border border-[#f0dfcf]">
          <img src="https://images.unsplash.com/photo-1626777552726-4a6b54c97e46?auto=format&fit=crop&w=900&q=85"
               alt="Masala dosa" class="w-full h-56 object-cover">
          <div class="p-6">
            <div class="flex justify-between items-start gap-3">
              <h3 class="font-bold text-xl">South Indian Dosa</h3>
              <span class="font-bold text-[#c75b39]">₹189</span>
            </div>
            <p class="text-sm text-[#755b66] mt-3 leading-relaxed">
              Thin, crisp dosa filled with seasoned potato masala, served with sambar.
            </p>
            <div class="flex justify-between items-center mt-5">
              <span class="text-sm text-[#9a7c80]"><i class="fa-solid fa-star text-[#e5b85c] mr-1"></i>4.9 (180+)</span>
              <span class="text-xs bg-[#f5e8d5] text-[#572d46] px-3 py-1 rounded-full">Classic</span>
            </div>
          </div>
        </div>

        <!-- DISH 5 -->
        <div class="food-card bg-white rounded-3xl overflow-hidden border border-[#f0dfcf]">
          <img src="https://images.unsplash.com/photo-1567188040759-fb8a883dc6d8?auto=format&fit=crop&w=900&q=85"
               alt="Chole bhature" class="w-full h-56 object-cover">
          <div class="p-6">
            <div class="flex justify-between items-start gap-3">
              <h3 class="font-bold text-xl">Chole Bhature</h3>
              <span class="font-bold text-[#c75b39]">₹219</span>
            </div>
            <p class="text-sm text-[#755b66] mt-3 leading-relaxed">
              Spicy chickpea curry paired with fluffy, deep-fried bhature and pickles.
            </p>
            <div class="flex justify-between items-center mt-5">
              <span class="text-sm text-[#9a7c80]"><i class="fa-solid fa-star text-[#e5b85c] mr-1"></i>4.8 (200+)</span>
              <span class="text-xs bg-[#f5e8d5] text-[#572d46] px-3 py-1 rounded-full">Hearty</span>
            </div>
          </div>
        </div>

        <!-- DISH 6 -->
        <div class="food-card bg-white rounded-3xl overflow-hidden border border-[#f0dfcf]">
          <img src="https://images.unsplash.com/photo-1601050690117-94f5f6fa8bd7?auto=format&fit=crop&w=900&q=85"
               alt="Gulab jamun dessert" class="w-full h-56 object-cover">
          <div class="p-6">
            <div class="flex justify-between items-start gap-3">
              <h3 class="font-bold text-xl">Gulab Jamun</h3>
              <span class="font-bold text-[#c75b39]">₹89</span>
            </div>
            <p class="text-sm text-[#755b66] mt-3 leading-relaxed">
              Soft, warm milk-solid dumplings soaked in fragrant cardamom sugar syrup.
            </p>
            <div class="flex justify-between items-center mt-5">
              <span class="text-sm text-[#9a7c80]"><i class="fa-solid fa-star text-[#e5b85c] mr-1"></i>5.0 (230+)</span>
              <span class="text-xs bg-[#f5e8d5] text-[#572d46] px-3 py-1 rounded-full">Sweet Treat</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="bg-[#f5e8d5] py-20">
    <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-12 items-center">
      <div>
        <img src="https://images.unsplash.com/photo-1555939594-58d7cb561ad1?auto=format&fit=crop&w=1000&q=85"
             alt="Indian food shared at a table"
             class="rounded-3xl w-full h-[380px] object-cover shadow-lg">
      </div>
      <div>
        <p class="accent font-bold text-sm tracking-widest uppercase mb-3">Our Story</p>
        <h2 class="text-3xl md:text-4xl font-extrabold mb-6">Bringing India's Streets to Your Table</h2>
        <p class="text-[#755b66] leading-relaxed mb-5">
          At SpiceRoute, we celebrate the food that makes India's streets unforgettable. Our menu takes inspiration from regional favourites, familiar flavours, and the joy of sharing a meal.
        </p>
        <p class="text-[#755b66] leading-relaxed mb-8">
          Every dish is prepared with care, fresh ingredients, and a little extra love—because great food is about more than taste.
        </p>
        <a href="#contact" class="btn-primary inline-block px-7 py-3 rounded-full font-semibold">
          Get in Touch
        </a>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="py-20">
    <div class="max-w-5xl mx-auto px-6 text-center">
      <p class="accent font-bold text-sm tracking-widest uppercase mb-3">Come Say Hello</p>
      <h2 class="text-3xl md:text-4xl font-extrabold mb-4">Good Food. Good Company.</h2>
      <p class="text-[#755b66] mb-8">Have a question or planning a visit? We'd love to hear from you.</p>

      <div class="grid sm:grid-cols-3 gap-6">
        <div class="bg-white border border-[#f0dfcf] rounded-2xl p-6">
          <i class="fa-solid fa-location-dot text-2xl text-[#c75b39] mb-3"></i>
          <h3 class="font-bold mb-2">Visit Us</h3>
          <p class="text-sm text-[#755b66]">Your City, India</p>
        </div>
        <div class="bg-white border border-[#f0dfcf] rounded-2xl p-6">
          <i class="fa-solid fa-phone text-2xl text-[#c75b39] mb-3"></i>
          <h3 class="font-bold mb-2">Call Us</h3>
          <p class="text-sm text-[#755b66]">+91 98765 43210</p>
        </div>
        <div class="bg-white border border-[#f0dfcf] rounded-2xl p-6">
          <i class="fa-solid fa-envelope text-2xl text-[#c75b39] mb-3"></i>
          <h3 class="font-bold mb-2">Email Us</h3>
          <p class="text-sm text-[#755b66]">hello@spiceroute.com</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="bg-[#351b35] text-white py-8">
    <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-4">
      <a href="#" class="text-xl font-extrabold">
        <i class="fa-solid fa-pepper-hot text-[#e5b85c] mr-2"></i>SpiceRoute
      </a>
      <p class="text-white/60 text-sm text-center">© 2026 SpiceRoute. Made with love and a little spice.</p>
      <div class="flex gap-5 text-lg">
        <a href="#" aria-label="Instagram" class="hover:text-[#e5b85c]"><i class="fa-brands fa-instagram"></i></a>
        <a href="#" aria-label="Facebook" class="hover:text-[#e5b85c]"><i class="fa-brands fa-facebook"></i></a>
        <a href="#" aria-label="Twitter" class="hover:text-[#e5b85c]"><i class="fa-brands fa-x-twitter"></i></a>
      </div>
    </div>
  </footer>

  <script>
    const menuBtn = document.getElementById('menuBtn');
    const mobileMenu = document.getElementById('mobileMenu');

    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    });
  </script>

</body>
</html>
